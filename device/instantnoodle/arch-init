#!/bin/sh
# First userspace for the explicitly labelled Arch root filesystem.
if [ "$$" -ne 1 ]; then echo 'Refusing outside PID 1.' >&2; exit 1; fi
export PATH=/bin
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs -o mode=0755 tmpfs /run
exec >/run/arch-init.log 2>&1
log() { echo "OP8ARCH: $*"; echo "<6>OP8ARCH: $*" >/dev/kmsg; }
fail() { log "FATAL: $*"; [ ! -c /dev/ttyGS0 ] || cat /run/arch-init.log >/dev/ttyGS0; while :; do sleep 30; done; }
log 'PID 1 running; no root device has been selected yet'
case " $(cat /proc/cmdline) " in
    *' op8.arch=1 '*) ;;
    *) fail 'missing explicit op8.arch=1 command line' ;;
esac

usb_setup() {
    for module in libcomposite u_serial usb_f_acm usb_f_ncm; do
        [ ! -f "/modules/$module.ko" ] || insmod "/modules/$module.ko" || {
            log "USB module load failed: $module"
            return 1
        }
    done
    mkdir -p /sys/kernel/config || return 1
    mount -t configfs configfs /sys/kernel/config || {
        log 'USB configfs mount failed'
        return 1
    }
    g=/sys/kernel/config/usb_gadget/op8arch
    mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409" \
        "$g/functions/acm.usb0" "$g/functions/ncm.usb0" || return 1
    echo 0x0525 >"$g/idVendor" || return 1
    echo 0xa4a7 >"$g/idProduct" || return 1
    echo 0x0200 >"$g/bcdUSB" || return 1
    echo op8-arch-prototype >"$g/strings/0x409/serialnumber" || return 1
    echo 'Local bring-up experiment' >"$g/strings/0x409/manufacturer" || return 1
    echo 'OP8 Arch Linux ARM' >"$g/strings/0x409/product" || return 1
    echo 'CDC ACM console and NCM network' >"$g/configs/c.1/strings/0x409/configuration" || return 1
    echo 100 >"$g/configs/c.1/MaxPower" || return 1
    ln -s "$g/functions/acm.usb0" "$g/configs/c.1/acm.usb0" || return 1
    ln -s "$g/functions/ncm.usb0" "$g/configs/c.1/ncm.usb0" || return 1
    udc=
    tries=0
    while [ "$tries" -lt 5 ]; do
        for p in /sys/class/udc/*; do [ ! -e "$p" ] || { udc=${p##*/}; break; }; done
        [ -z "$udc" ] || break
        tries=$((tries + 1)); sleep 1
    done
    [ -n "$udc" ] || { log 'USB device controller unavailable'; return 1; }
    echo "$udc" >"$g/UDC" || { log "USB gadget bind failed: $udc"; return 1; }
    log "USB ACM/NCM bound to $udc"
}
usb_setup || log 'USB gadget unavailable; continuing to labelled Arch rootfs'

rootdev=
tries=0
while [ "$tries" -lt 60 ] && [ -z "$rootdev" ]; do
    for dev in /dev/sd*[0-9] /dev/nvme*n*p*; do
        [ -b "$dev" ] || continue
        label=$(blkid -s LABEL -o value "$dev" 2>/dev/null || true)
        [ "$label" != arch-root ] || { rootdev=$dev; break; }
    done
    [ -n "$rootdev" ] || { tries=$((tries + 1)); sleep 1; }
done
[ -n "$rootdev" ] || fail 'no block device labelled arch-root found'
log "selected root=$rootdev by exact filesystem label"
mkdir -p /newroot
mount -t ext4 -o rw,noatime "$rootdev" /newroot || fail 'root mount failed'
[ -x /newroot/sbin/init ] || fail 'root has no executable /sbin/init'
persist_step() {
    procdir=/proc
    [ ! -r /newroot/proc/uptime ] || procdir=/newroot/proc
    read uptime _ <"$procdir/uptime"
    bootid=$(cat "$procdir/sys/kernel/random/boot_id")
    kmsg=/dev/kmsg
    [ ! -c /newroot/dev/kmsg ] || kmsg=/newroot/dev/kmsg
    printf '<6>OP8ARCH: boot=%s uptime=%s step=%s\n' "$bootid" "$uptime" "$1" >"$kmsg"
    printf 'boot=%s uptime=%s step=%s\n' "$bootid" "$uptime" "$1" \
        >>/newroot/var/log/op8-early-boot.log
    sync
}
persist_step root-mounted
for dir in dev proc sys run; do mkdir -p "/newroot/$dir"; mount --move "/$dir" "/newroot/$dir" || fail "move $dir failed"; done
persist_step mounts-moved
persist_step switch-root
exec switch_root /newroot /sbin/init
