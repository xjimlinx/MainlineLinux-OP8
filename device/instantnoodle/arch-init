#!/bin/sh
# First userspace for the explicitly labelled Arch root filesystem.
if [ "$$" -ne 1 ]; then echo 'Refusing outside PID 1.' >&2; exit 1; fi
export PATH=/bin
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs -o mode=0755 tmpfs /run
exec >/run/arch-init.log 2>&1
log() { echo "OP8ARCH: $*"; echo "<6>OP8ARCH: $*" >/dev/kmsg; }
fail() { log "FATAL: $*"; [ ! -c /dev/ttyGS0 ] || cat /run/arch-init.log >/dev/ttyGS0; while :; do sleep 30; done; }
log 'PID 1 running; no root device has been selected yet'
case " $(cat /proc/cmdline) " in
    *' op8.arch=1 '*) ;;
    *) fail 'missing explicit op8.arch=1 command line' ;;
esac

# The validated 6.16.7 kernel has libcomposite, ACM and NCM built in.  Keep
# compatibility with older modular test kernels, but do not fail when the
# functions are already built into vmlinux.
for module in libcomposite u_serial usb_f_acm usb_f_ncm; do
    [ ! -f "/modules/$module.ko" ] || insmod "/modules/$module.ko" || \
        fail "module load failed: $module"
done
mkdir -p /sys/kernel/config
mount -t configfs configfs /sys/kernel/config || fail 'configfs mount failed'
g=/sys/kernel/config/usb_gadget/op8arch
mkdir -p "$g/strings/0x409" "$g/configs/c.1/strings/0x409" \
    "$g/functions/acm.usb0" "$g/functions/ncm.usb0"
echo 0x0525 >"$g/idVendor"; echo 0xa4a7 >"$g/idProduct"; echo 0x0200 >"$g/bcdUSB"
echo op8-arch-prototype >"$g/strings/0x409/serialnumber"
echo 'Local bring-up experiment' >"$g/strings/0x409/manufacturer"
echo 'OP8 Arch Linux ARM' >"$g/strings/0x409/product"
echo 'CDC ACM console and NCM network' >"$g/configs/c.1/strings/0x409/configuration"
echo 100 >"$g/configs/c.1/MaxPower"
ln -s "$g/functions/acm.usb0" "$g/configs/c.1/acm.usb0"
ln -s "$g/functions/ncm.usb0" "$g/configs/c.1/ncm.usb0"
udc=
tries=0
while [ "$tries" -lt 60 ]; do
    for p in /sys/class/udc/*; do [ ! -e "$p" ] || { udc=${p##*/}; break; }; done
    [ -z "$udc" ] || break
    tries=$((tries + 1)); sleep 1
done
[ -n "$udc" ] || fail 'no USB device controller'
echo "$udc" >"$g/UDC" || fail 'cannot bind USB ACM gadget'

rootdev=
tries=0
while [ "$tries" -lt 60 ] && [ -z "$rootdev" ]; do
    for dev in /dev/sd*[0-9] /dev/nvme*n*p*; do
        [ -b "$dev" ] || continue
        label=$(blkid -s LABEL -o value "$dev" 2>/dev/null || true)
        [ "$label" != arch-root ] || { rootdev=$dev; break; }
    done
    [ -n "$rootdev" ] || { tries=$((tries + 1)); sleep 1; }
done
[ -n "$rootdev" ] || fail 'no block device labelled arch-root found'
log "selected root=$rootdev by exact filesystem label"
mkdir -p /newroot
mount -t ext4 -o rw,noatime "$rootdev" /newroot || fail 'root mount failed'
[ -x /newroot/sbin/init ] || fail 'root has no executable /sbin/init'
for dir in dev proc sys run; do mkdir -p "/newroot/$dir"; mount --move "/$dir" "/newroot/$dir" || fail "move $dir failed"; done
echo 'Arch root verified; switching to systemd. Login on ttyGS0.' >/newroot/dev/ttyGS0 2>/dev/null || true
exec switch_root /newroot /sbin/init
