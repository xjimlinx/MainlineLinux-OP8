/* SPDX-License-Identifier: GPL-2.0-only */
/*
 * Minimal arm64 Android-boot copy-down shim for OnePlus 8 bring-up.
 *
 * ABL enters this outer Image.  The real Linux Image is embedded at a 2 MiB
 * boundary.  Execution moves to code beyond the copy ranges, copies Linux to
 * the address at which ABL placed the outer Image, cleans data cache, drops
 * stale instructions, restores ABL's DTB pointer in x0, and enters Linux.
 */

.section .text
.global _start
_start:
	b .Ldispatch
	.word 0
	.quad 0x80000
	.quad .Limage_end - _start
	.quad 0x0a
	.quad 0
	.quad 0
	.quad 0
	.ascii "ARMd"
	.word 0

.Ldispatch:
	mov x20, x0
	adrp x9, .Lcopy
	add x9, x9, :lo12:.Lcopy
	br x9

/* Keep the embedded Image naturally aligned and away from the shim header. */
.balign 0x200000
.Llinux:
	.incbin "@LINUX_IMAGE@"
.balign 8
.Llinux_end:

/* This routine must remain outside both the source and destination ranges. */
.balign 0x1000
.Lcopy:
#ifdef OP8_TAIL_RESET
	movz x0, #0x0009
	movk x0, #0x8400, lsl #16
	smc #0
	movz x0, #0x0009
	movk x0, #0x8400, lsl #16
	hvc #0
.Ltail_reset_hang:
	wfe
	b .Ltail_reset_hang
#endif
	adrp x10, _start
	add x10, x10, :lo12:_start
	adrp x11, .Llinux
	add x11, x11, :lo12:.Llinux
	adrp x12, .Llinux_end
	add x12, x12, :lo12:.Llinux_end
	mov x13, x10
	sub x14, x12, x11
	add x14, x13, x14

.Lcopy_loop:
	cmp x11, x12
	b.hs .Lcopy_done
	ldr x15, [x11], #8
	str x15, [x10], #8
	b .Lcopy_loop

.Lcopy_done:
	/* CTR_EL0.DminLine is log2(words); convert it to bytes. */
	mrs x5, ctr_el0
	ubfx x5, x5, #16, #4
	mov x6, #4
	lsl x5, x6, x5
	mov x6, x13

.Lclean_loop:
	cmp x6, x14
	b.hs .Lclean_done
	dc cvau, x6
	add x6, x6, x5
	b .Lclean_loop

.Lclean_done:
#ifdef OP8_COPY_RESET
	dsb ish
	ic iallu
	dsb ish
	isb
	movz x0, #0x0009
	movk x0, #0x8400, lsl #16
	smc #0
	movz x0, #0x0009
	movk x0, #0x8400, lsl #16
	hvc #0
.Lreset_hang:
	wfe
	b .Lreset_hang
#else
	/* Make the embedded runtime DTB visible before passing it to Linux. */
	adrp x6, .Lruntime_dtb
	add x6, x6, :lo12:.Lruntime_dtb
	adrp x8, .Lruntime_dtb_end
	add x8, x8, :lo12:.Lruntime_dtb_end

.Ldtb_clean_loop:
	cmp x6, x8
	b.hs .Ldtb_clean_done
	dc cvau, x6
	add x6, x6, x5
	b .Ldtb_clean_loop

.Ldtb_clean_done:
	dsb ish
	ic iallu
	dsb ish
	isb
	adrp x0, .Lruntime_dtb
	add x0, x0, :lo12:.Lruntime_dtb
	mov x1, xzr
	mov x2, xzr
	mov x3, xzr
	br x13
#endif

.balign 0x1000
.Lruntime_dtb:
	.incbin "@RUNTIME_DTB@"
.balign 8
.Lruntime_dtb_end:

.balign 0x1000
.Limage_end:
